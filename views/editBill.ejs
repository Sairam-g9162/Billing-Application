<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Bill</title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    .search-container {
      margin-bottom: 20px;
      padding: 15px;
      background-color: #f5f5f5;
      border-radius: 5px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    
    .search-form {
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
    }
    
    .search-form > div {
      display: flex;
      align-items: center;
      gap: 5px;
    }
    
    .search-form button {
      background-color: #4CAF50;
      color: white;
      border: none;
      padding: 8px 15px;
      cursor: pointer;
      border-radius: 4px;
    }
    
    .search-form button:hover {
      background-color: #45a049;
    }
    
    .not-found {
      margin: 20px 0;
      font-weight: 600;
      text-align: center;
    }
    
    .form-container {
      opacity: 0.3;
      pointer-events: none;
    }
    
    .form-container.active {
      opacity: 1;
      pointer-events: auto;
    }
    
    /* Success modal styles */
    .success-modal {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: auto;
      background-color: rgba(0,0,0,0.4);
      align-items: center;
      justify-content: center;
    }
    
    .success-content {
      background-color: white;
      padding: 40px;
      border-radius: 10px;
      text-align: center;
      box-shadow: 0 5px 15px rgba(0,0,0,0.3);
      display: flex;
      flex-direction: column;
      align-items: center;
      max-width: 400px;
      width: 90%;
    }
    
    .checkmark-circle {
      width: 80px;
      height: 80px;
      position: relative;
      margin-bottom: 20px;
    }
    
    .checkmark__circle {
      stroke-dasharray: 166;
      stroke-dashoffset: 166;
      stroke-width: 2;
      stroke: #4CAF50;
      fill: none;
      animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
    }
    
    .checkmark__check {
      transform-origin: 50% 50%;
      stroke-dasharray: 48;
      stroke-dashoffset: 48;
      stroke-width: 3;
      stroke: #4CAF50;
      animation: stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.8s forwards;
    }
    
    @keyframes stroke {
      100% {
        stroke-dashoffset: 0;
      }
    }
  </style>
</head>
<!-- Fix for the date field in editBill.ejs -->
<body>
  <div class="container">
    <a href="/" class="back-button">Home</a>
    <h1>Edit Bill</h1>
    
    <!-- Display success or error messages -->
    <% if (error) { %>
      <p style="color: red;"><%= error %></p>
    <% } %>
    <% if (success) { %>
      <p style="color: green;"><%= success %></p>
    <% } %>

    <!-- Search Form -->
    <div class="search-container">
      <h2><gradient-wrapper>Search Bill</gradient-wrapper></h2>
      <form action="/fetch-bill" method="POST" class="search-form">
        <div>
          <label for="tableName"><gradient-wrapper>Bill Type:</gradient-wrapper></label>
          <select id="tableName" name="tableName" required>
            <option value="active_pledges">Standard Bill</option>
            <option value="S_active_pledges">S Series Bill</option>
          </select>
        </div>
        <div>
          <label for="searchBillNumber"><gradient-wrapper>Bill Number:</gradient-wrapper></label>
          <input type="text" id="searchBillNumber" name="billNumber" required>
        </div>
        <button type="submit">Search</button>
      </form>
    </div>

    <% if (searched && !bill) { %>
      <div class="not-found" style="">
        <gradient-wrapper>Verify once if the bill is already Released or Not added yet !</gradient-wrapper>
        <p><gradient-wrapper>Make Sure you are searching in correct bill Series !</gradient-wrapper></p>
      </div>
    <% } %>

    <!-- Edit Form -->
    <div class="form-container <%= bill ? 'active' : '' %>" id="formContainer">
      <h2><gradient-wrapper>Edit Bill Details</gradient-wrapper></h2>
      
      <form action="/update-bill" method="POST" id="billForm">
        <!-- Hidden field for table name -->
        <input type="hidden" id="tableName" name="tableName" value="<%= bill ? tableName : '' %>">
        
        <div>
          <label for="billNumber"><gradient-wrapper>Bill Number*</gradient-wrapper></label>
          <input type="text" id="billNumber" name="billNumber" value="<%= bill ? bill['Bill Number'] : '' %>" readonly>
        </div>
        <div>
          <label for="name"><gradient-wrapper>Name*</gradient-wrapper></label>
          <input type="text" id="name" name="name" required value="<%= bill ? bill.Name : '' %>">
        </div>
        <div>
          <label for="fatherOrSpouseName"><gradient-wrapper>S/O or W/O*</gradient-wrapper></label>
          <input type="text" id="fatherOrSpouseName" name="fatherOrSpouseName" required value="<%= bill ? bill.FatherorSpouseName : '' %>">
        </div>
        <div>
          <label for="date"><gradient-wrapper>Date*</gradient-wrapper></label>
          <!-- Fixed date input with proper max date calculation -->
          <input type="date" id="date" name="date" required value="<%= bill ? bill.Date : '' %>">
        </div>
        <div>
          <label for="phoneNumber"><gradient-wrapper>Phone Number*</gradient-wrapper></label>
          <input type="number" id="phoneNumber" name="phoneNumber" required maxlength="10" oninput="validatePhoneNumber(this)" value="<%= bill ? bill['Phone Number'] : '' %>">
        </div>
        <div>
          <label for="address"><gradient-wrapper>Address</gradient-wrapper></label>
          <textarea id="address" name="address"><%= bill ? bill.Address : '' %></textarea>
        </div>
        <div>
          <label for="townOrCity"><gradient-wrapper>Town/City*</gradient-wrapper></label>
          <input type="text" id="townOrCity" name="townOrCity" required value="<%= bill ? bill.townOrCity : '' %>">
        </div>
        <div>
          <label for="aadharNumber"><gradient-wrapper>Aadhar Number</gradient-wrapper></label>
          <input type="number" id="aadharNumber" name="aadharNumber" maxlength="12" oninput="validateAadharNumber(this)" value="<%= bill && bill.Aadhar_Number ? bill.Aadhar_Number : '' %>">
        </div>
        <div>
          <label for="goldSilver"><gradient-wrapper>Gold/Silver*</gradient-wrapper></label>
          <select id="goldSilver" name="goldSilver" required onchange="toggleGrossWeightFields()">
            <option value="Gold" <%= bill && bill['Gold/Silver'] === 'Gold' ? 'selected' : '' %>>Gold</option>
            <option value="Silver" <%= bill && bill['Gold/Silver'] === 'Silver' ? 'selected' : '' %>>Silver</option>
            <option value="GoldSilver" <%= bill && bill['Gold/Silver'] === 'GoldSilver' ? 'selected' : '' %>>Gold & Silver</option>
          </select>
        </div>

        <!-- Gross Weight Fields (conditionally displayed) -->
        <div id="grossGoldWeightContainer" style="display: none;">
          <label for="goldGrossWeight"><gradient-wrapper>Gross Gold Weight (gms)*</gradient-wrapper></label>
          <input type="number" id="goldGrossWeight" name="goldGrossWeight" step="0.001" min="0" value="<%= bill && bill.Gold_Gross_Weight ? bill.Gold_Gross_Weight : '' %>">
        </div>
        <div id="grossSilverWeightContainer" style="display: none;">
          <label for="silverGrossWeight"><gradient-wrapper>Gross Silver Weight (gms)*</gradient-wrapper></label>
          <input type="number" id="silverGrossWeight" name="silverGrossWeight" step="0.001" min="0" value="<%= bill && bill.Silver_Gross_Weight ? bill.Silver_Gross_Weight : '' %>">
        </div>

        <div>
          <label for="noOfItems"><gradient-wrapper>Number of Items*</gradient-wrapper></label>
          <input type="number" id="noOfItems" name="noOfItems" min="1" required value="<%= bill ? bill.No_of_items : '' %>">
          <button type="button" onclick="generateItemFields()">Generate Item Fields</button>
        </div>
        <div id="itemFields" class="item-grid">
          <% if (bill && bill.Items && bill.Items_Value) { %>
            <% let itemIndex = 1; %>
            <% for (const [itemName, itemWeight] of Object.entries(bill.Items)) { %>
              <div class="item-row">
                <div class="item-label">Item <%= itemIndex %>:</div>
                <div class="item-inputs">
                  <input type="text" id="itemName<%= itemIndex %>" name="itemName<%= itemIndex %>" value="<%= itemName %>" required>
                  <input type="number" id="itemWeight<%= itemIndex %>" name="itemWeight<%= itemIndex %>" value="<%= itemWeight.replace('gms', '') %>" step="0.001" min="0" required onblur="formatWeight(this)" onchange="updateTotalWeight()">
                  <span>gms</span>
                  <input type="number" id="itemValue<%= itemIndex %>" name="itemValue<%= itemIndex %>" value="<%= bill.Items_Value[itemName] || '' %>" placeholder="Value (₹)" min="0" required>
                </div>
              </div>
              <% itemIndex++; %>
            <% } %>
          <% } %>
        </div>
        
        <!-- Total Weight Display -->
        <div id="totalWeightsContainer" style="margin-top: 15px; display: <%= bill ? 'block' : 'none' %>;">
          <p><strong>Total Weight: </strong><span id="totalWeight">0.000</span> gms</p>
        </div>

        <div>
          <label for="remarks"><gradient-wrapper>Remarks</gradient-wrapper></label>
          <textarea id="remarks" name="remarks"><%= bill && bill.Remarks ? bill.Remarks : '' %></textarea>
        </div>
        <div>
          <label for="interestRate"><gradient-wrapper>Interest Rate (%)*</gradient-wrapper></label>
          <input type="number" id="interestRate" name="interestRate" step="0.1" required value="<%= bill ? bill['Interest Rate'] : '16' %>">
        </div>
        <div>
          <label for="initialPledgedAmount"><gradient-wrapper>Initial Pledged Amount*</gradient-wrapper></label>
          <input type="number" id="initialPledgedAmount" name="initialPledgedAmount" required value="<%= bill ? bill['Initial Pledged Amount'] : '' %>">
        </div>
        <!-- Hidden fields for JSON data -->
        <input type="hidden" id="items" name="items" value="<%= bill ? JSON.stringify(bill.Items) : '{}' %>">
        <input type="hidden" id="itemsValue" name="itemsValue" value="<%= bill && bill.Items_Value ? JSON.stringify(bill.Items_Value) : '{}' %>">
        <input type="hidden" id="principleAddingHis" name="principleAddingHis" value="<%= bill && bill.Principle_Adding_His ? JSON.stringify(bill.Principle_Adding_His) : '{}' %>">
        <input type="hidden" id="repayHistory" name="repayHistory" value="<%= bill && bill.Repay_History ? JSON.stringify(bill.Repay_History) : '{}' %>">
        
        <button type="button" onclick="showConfirmation(event)">Preview Changes</button>
        <button type="submit" style="display:none;" id="submitButton">Update Bill</button>
      </form>
    </div>
  </div>

  <!-- Confirmation Modal -->
  <div id="confirmationModal" class="modal">
    <div class="modal-content">
      <div class="modal-left">
        <h3><gradient-wrapper>Confirm Bill Updates</gradient-wrapper></h3>
        <p><strong>Bill Type:</strong> <span id="confirmBillType"></span></p>
        <p><strong>Bill Number:</strong> <span id="confirmBillNumber"></span></p>
        <p><strong>Name:</strong> <span id="confirmName"></span></p>
        <p><strong>Phone Number:</strong> <span id="confirmPhone"></span></p>
        <p><strong>Pledged Amount:</strong> <span id="confirmAmount"></span></p>
        <div id="confirmGrossWeights"></div>
        <p><strong>Items:</strong> <span id="confirmItems"></span></p>
        <p><strong>Remarks:</strong> <span id="confirmRemarks"></span></p>
      </div>
      <div class="modal-buttons">
        <button onclick="confirmAndSubmit()">Confirm & Update</button>
        <button onclick="closeModal()">Cancel</button>
      </div>
    </div>
  </div>
  
  <!-- Success Modal -->
  <div id="successModal" class="success-modal">
    <div class="success-content">
      <div class="checkmark-circle">
        <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
          <circle class="checkmark__circle" cx="26" cy="26" r="25" fill="none"/>
          <path class="checkmark__check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
        </svg>
      </div>
      <p id="successMessage">Bill updated successfully!</p>
    </div>
  </div>

  <script>
    // When the page loads, update the display of gross weight fields and set max date for date input
    window.addEventListener('load', function() {
      if (document.getElementById('billForm').goldSilver) {
        toggleGrossWeightFields();
        updateTotalWeight();
      }
      
      // Set the max date for the date input to today
      const today = new Date();
      const dateInput = document.getElementById('date');
      if (dateInput) {
        // Format today's date as YYYY-MM-DD for the max attribute
        const year = today.getFullYear();
        const month = String(today.getMonth() + 1).padStart(2, '0');
        const day = String(today.getDate()).padStart(2, '0');
        dateInput.max = `${year}-${month}-${day}`;
      }
    });
    
    document.getElementById('billForm').addEventListener('keypress', function(e) {
      // Check if the key pressed was Enter
      if (e.key === 'Enter') {
        // Prevent the default form submission
        e.preventDefault();
        
        // Instead trigger the preview modal if all required fields are filled
        showConfirmation(e);
      }
    });
    // Toggle gross weight fields based on gold/silver selection
    function toggleGrossWeightFields() {
      const selection = document.getElementById('goldSilver').value;
      const goldContainer = document.getElementById('grossGoldWeightContainer');
      const silverContainer = document.getElementById('grossSilverWeightContainer');
      
      // Toggle visibility
      if (selection === 'Gold' || selection === 'GoldSilver') {
        goldContainer.style.display = 'block';
        document.getElementById('goldGrossWeight').required = true;
      } else {
        goldContainer.style.display = 'none';
        document.getElementById('goldGrossWeight').required = false;
        document.getElementById('goldGrossWeight').value = '';
      }
      
      if (selection === 'Silver' || selection === 'GoldSilver') {
        silverContainer.style.display = 'block';
        document.getElementById('silverGrossWeight').required = true;
      } else {
        silverContainer.style.display = 'none';
        document.getElementById('silverGrossWeight').required = false;
        document.getElementById('silverGrossWeight').value = '';
      }
    }

    // Format weight with 3 decimal places
    function formatWeight(input) {
      if (input.value) {
        // Parse the input value and format it to 3 decimal places
        const formattedValue = parseFloat(input.value).toFixed(3);
        // Update the input field with the formatted value
        input.value = formattedValue;
      }
    }
    document.addEventListener('keydown', function(event) {
        // Check if Alt + H is pressed
        if (event.altKey && event.key.toLowerCase() === 'h') {
          event.preventDefault(); // Prevent default browser behavior
          window.location.href = '/';
        }
      });
    // Handle item field generation based on number of items
    function generateItemFields() {
      const noOfItems = parseInt(document.getElementById('noOfItems').value);
      const itemFieldsDiv = document.getElementById('itemFields');
      itemFieldsDiv.innerHTML = '';

      if (isNaN(noOfItems) || noOfItems < 1) {
        alert('Please enter a valid number of items (minimum 1).');
        return;
      }

      for (let i = 1; i <= noOfItems; i++) {
        const itemRow = document.createElement('div');
        itemRow.className = 'item-row';
        itemRow.innerHTML = `
          <div class="item-label">Item ${i}:</div>
          <div class="item-inputs">
            <input type="text" id="itemName${i}" name="itemName${i}" placeholder="Item name" required>
            <input type="number" id="itemWeight${i}" name="itemWeight${i}" placeholder="Weight" step="0.001" min="0" required 
                   onblur="formatWeight(this)" onchange="updateTotalWeight()">
            <span>gms</span>
            <input type="number" id="itemValue${i}" name="itemValue${i}" placeholder="Value (₹)" min="0" required>
          </div>
        `;
        itemFieldsDiv.appendChild(itemRow);
      }
      
      document.getElementById('totalWeightsContainer').style.display = 'block';
    }

    function updateTotalWeight() {
      const noOfItems = parseInt(document.getElementById('noOfItems').value);
      let totalWeight = 0;
      
      for (let i = 1; i <= noOfItems; i++) {
        const weightInput = document.getElementById(`itemWeight${i}`);
        if (weightInput && !isNaN(parseFloat(weightInput.value))) {
          totalWeight += parseFloat(weightInput.value);
        }
      }
      
      // Display with 3 decimal places
      document.getElementById('totalWeight').textContent = totalWeight.toFixed(3);
    }
    
    function validatePhoneNumber(input) {
      // Ensure it's a valid 10-digit phone number
      if (input.value.length > 10) {
        input.value = input.value.slice(0, 10);
      }
      
      // Only allow digits
      input.value = input.value.replace(/[^0-9]/g, '');
    }

    function validateAadharNumber(input) {
      // Ensure it's a valid 12-digit Aadhar number
      if (input.value.length > 12) {
        input.value = input.value.slice(0, 12);
      }
      
      // Only allow digits
      input.value = input.value.replace(/[^0-9]/g, '');
    }

    function showConfirmation(event) {
      event.preventDefault();
      
      // Validate all required fields
      const form = document.getElementById('billForm');
      if (!form.checkValidity()) {
        // Trigger browser's built-in validation
        form.reportValidity();
        return;
      }
      
      // Build the items and values JSON
      const result = buildItemsJson();
      if (!result) {
        return; // Validation failed
      }
      
      // Set the hidden field values
      document.getElementById('items').value = JSON.stringify(result.itemsObj);
      document.getElementById('itemsValue').value = JSON.stringify(result.itemsValueObj);

      // Determine bill type
      const tableNameField = document.getElementById('tableName');
      const billTypeText = tableNameField.value === 'S_active_pledges' ? 'S Series' : 'Standard';

      // Set confirmation modal details
      document.getElementById('confirmBillType').textContent = billTypeText;
      document.getElementById('confirmBillNumber').textContent = form.billNumber.value;
      document.getElementById('confirmName').textContent = form.name.value;
      document.getElementById('confirmPhone').textContent = form.phoneNumber.value;
      document.getElementById('confirmAmount').textContent = form.initialPledgedAmount.value;
      
      // Add gross weight info to confirmation
      const grossWeightsDiv = document.getElementById('confirmGrossWeights');
      grossWeightsDiv.innerHTML = '';
      
      const goldSilver = form.goldSilver.value;
      if (goldSilver === 'Gold' || goldSilver === 'GoldSilver') {
        const p = document.createElement('p');
        p.innerHTML = `<strong>Gross Gold Weight:</strong> ${form.goldGrossWeight.value} gms`;
        grossWeightsDiv.appendChild(p);
      }
      
      if (goldSilver === 'Silver' || goldSilver === 'GoldSilver') {
        const p = document.createElement('p');
        p.innerHTML = `<strong>Gross Silver Weight:</strong> ${form.silverGrossWeight.value} gms`;
        grossWeightsDiv.appendChild(p);
      }
      
      // Format the items for display
      const itemsForDisplay = Object.entries(result.itemsObj)
        .map(([name, weight]) => `${name}: ${weight}`)
        .join(', ');
      document.getElementById('confirmItems').textContent = itemsForDisplay;
      
      document.getElementById('confirmRemarks').textContent = form.remarks.value || 'None';

      document.getElementById('confirmationModal').style.display = 'block';
    }

    function buildItemsJson() {
      const noOfItems = parseInt(document.getElementById('noOfItems').value);
      const itemsObj = {};
      const itemsValueObj = {};
      
      // Validate all fields are filled
      for (let i = 1; i <= noOfItems; i++) {
        const nameInput = document.getElementById(`itemName${i}`);
        const weightInput = document.getElementById(`itemWeight${i}`);
        const valueInput = document.getElementById(`itemValue${i}`);
        
        if (!nameInput || !nameInput.value || !weightInput || !weightInput.value || !valueInput || !valueInput.value) {
          alert('Please fill in all item details');
          return null;
        }
        
        // Format weight with 3 decimal places
        const weight = parseFloat(weightInput.value).toFixed(3);
        
        // Add to the JSON objects
        itemsObj[nameInput.value] = `${weight}gms`;
        itemsValueObj[nameInput.value] = valueInput.value;
      }
      
      return { itemsObj, itemsValueObj };
    }

    function closeModal() {
      document.getElementById('confirmationModal').style.display = 'none';
    }

    function confirmAndSubmit() {
      const form = document.getElementById('billForm');
      closeModal();
      
      // Get the bill number from the form
      const billNumber = form.billNumber.value;
      
      // Set the success message with the bill number
      document.getElementById('successMessage').textContent = `Bill Number ${billNumber} edited successfully!`;
      
      // Show the success modal instead of toaster
      // document.getElementById('successModal').style.display = 'flex';
      
      // Delay form submission slightly to allow success modal to be visible
      setTimeout(() => {
        form.submit();
      }, 100);
    }
    
    // Check for success parameter in URL to show success modal after redirect
    window.onload = function() {
      const urlParams = new URLSearchParams(window.location.search);
      const billNumber = urlParams.get('success');
      if (billNumber) {
        document.getElementById('successMessage').textContent = `Bill Number ${billNumber} edited successfully!`;
        document.getElementById('successModal').style.display = 'flex';
        setTimeout(() => {
          document.getElementById('successModal').style.display = 'none';
        }, 3000);
      }
    };
  </script>
   <footer>
    <p>Shanthi Pawn Brokers ®</p>
</footer>
</body>
</html>