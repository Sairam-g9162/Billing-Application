<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Bill</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="container">
    <a href="/" class="back-button">Home</a>
    <h1><gradient-wrapper>Add Bill</gradient-wrapper></h1>
    <!-- Display success or error messages -->
    <% if (error) { %>
      <p style="color: red;"><%= error %></p>
    <% } %>
    <% if (success) { %>
      <p style="color: green;"><%= success %></p>
    <% } %>

    <!-- Form -->
    <form action="/add-bill" method="POST" id="billForm">
      <!-- S Series Toggle Switch -->
      <div class="toggle-container">
        <label class="toggle-switch">
          <input type="checkbox" id="useSeries" name="useSeries">
          <span class="toggle-slider"></span>
        </label>
        <span class="toggle-label"><gradient-wrapper>S Series</gradient-wrapper></span>
      </div>
      
      <!-- Rest of the form fields -->
      <div>
        <label for="billNumber"><gradient-wrapper>Bill Number*</gradient-wrapper></label>
        <input type="text" id="billNumber" name="billNumber" value="<%= nextBillNumber %>">
      </div>
      <div>
        <label for="name"><gradient-wrapper>Name*</gradient-wrapper></label>
        <input type="text" id="name" name="name" required>
      </div>
      <div>
        <label for="fatherOrSpouseName"><gradient-wrapper>S/O or W/O*</gradient-wrapper></label>
        <input type="text" id="fatherOrSpouseName" name="fatherOrSpouseName" required>
      </div>

      <div>
        <label for="date"><gradient-wrapper>Date*</gradient-wrapper></label>
        <input type="date" id="date" name="date" required>
        <script>
            const today = new Date().toLocaleString('en-US', {
              timeZone: 'Asia/Kolkata'
            });
            const istDate = new Date(today);
            document.getElementById('date').value = istDate.toISOString().split('T')[0];
            document.getElementById('date').max = istDate.toISOString().split('T')[0];
        </script>
      </div>
      <div>
        <label for="phoneNumber"><gradient-wrapper>Phone Number*</gradient-wrapper></label>
        <input type="number" id="phoneNumber" name="phoneNumber" required maxlength="10" oninput="validatePhoneNumber(this)">
      </div>
      <div>
        <label for="address"><gradient-wrapper>Address</gradient-wrapper></label>
        <textarea id="address" name="address" ></textarea>
      </div>
      <div>
        <label for="townOrCity"><gradient-wrapper>Town/City*</gradient-wrapper></label>
        <input type="text" id="townOrCity" name="townOrCity" required>
      </div>
      <div>
        <label for="aadharNumber"><gradient-wrapper>Aadhar Number</gradient-wrapper></label>
        <input type="number" id="aadharNumber" name="aadharNumber" maxlength="12" oninput="validateAadharNumber(this)">
      </div>
      <div>
        <label for="goldSilver"><gradient-wrapper>Gold/Silver*</gradient-wrapper></label>
        <select id="goldSilver" name="goldSilver" required onchange="toggleGrossWeightFields()">
          <option value="Gold">Gold</option>  
          <option value="Silver">Silver</option>
          <option value="GoldSilver">Gold & Silver</option>
        </select>
      </div>

      <div>
        <label for="noOfItems"><gradient-wrapper>Number of Items*</gradient-wrapper></label>
        <input type="number" id="noOfItems" name="noOfItems" min="1" required>
        <button type="button" onclick="generateItemFields()">Generate Item Fields</button>
      </div>
      <div id="itemFields" class="item-grid"></div>
      
      <!-- Total Weight Display -->
      <div id="totalWeightsContainer" style="margin-top: 15px; display: none;">
        <p><strong>Total Items Weight: </strong><span id="totalWeight">0.000</span> gms</p>
      </div>
      
      <!-- Gross Weight Fields (repositioned after item fields) -->
      <div id="grossWeightContainer" style="margin-top: 15px; display: none;">
        <div id="grossGoldWeightContainer" style="display: none;">
          <label for="goldGrossWeight"><gradient-wrapper>Gross Gold Weight (gms)*</gradient-wrapper></label>
          <input type="number" id="goldGrossWeight" name="goldGrossWeight" step="0.001" min="0" readonly>
        </div>
        <div id="grossSilverWeightContainer" style="display: none;">
          <label for="silverGrossWeight"><gradient-wrapper>Gross Silver Weight (gms)*</gradient-wrapper></label>
          <input type="number" id="silverGrossWeight" name="silverGrossWeight" step="0.001" min="0" readonly>
        </div>
      </div>
      
      <div>
        <label for="remarks"><gradient-wrapper>Remarks</gradient-wrapper></label>
        <textarea id="remarks" name="remarks"></textarea>
      </div>
      <div>
        <label for="interestRate"><gradient-wrapper>Interest Rate (%)*</gradient-wrapper></label>
        <input type="number" id="interestRate" name="interestRate" step="0.1" value=16 readonly required>
      </div>
      <div>
        <label for="initialPledgedAmount"><gradient-wrapper>Initial Pledged Amount*</gradient-wrapper></label>
        <input type="number" id="initialPledgedAmount" name="initialPledgedAmount" required>
      </div>
      <!-- Hidden fields for JSON data -->
      <input type="hidden" id="items" name="items" value="{}">
      <input type="hidden" id="itemsValue" name="itemsValue" value="{}">
      <input type="hidden" id="principleAddingHis" name="principleAddingHis" value="{}">
      <input type="hidden" id="repayHistory" name="repayHistory" value="{}">
      
      <button type="button" onclick="showConfirmation(event)">Preview Bill</button>
      <button type="submit" style="display:none;" id="submitButton">Add Bill</button>
    </form>
  </div>

  <!-- Confirmation Modal -->
  <div id="confirmationModal" class="modal">
    <div class="modal-content">
      <div class="modal-left">
        <h3><gradient-wrapper>Confirm Bill Details</gradient-wrapper></h3>
        <p><strong>Bill Type:</strong> <span id="confirmBillType"></span></p>
        <p><strong>Bill Number:</strong> <span id="confirmBillNumber"></span></p>
        <p><strong>Name:</strong> <span id="confirmName"></span></p>
        <p><strong>Phone Number:</strong> <span id="confirmPhone"></span></p>
        <p><strong>Pledged Amount:</strong> <span id="confirmAmount"></span></p>
        <div id="confirmGrossWeights"></div>
        <p><strong>Items:</strong> <span id="confirmItems"></span></p>
        <p><strong>Remarks:</strong> <span id="confirmRemarks"></span></p>
      </div>
      <div class="modal-buttons">
        <button onclick="confirmAndSubmit()">Confirm & Submit</button>
        <button onclick="closeModal()">Cancel</button>
      </div>
    </div>
  </div>
 

  <script>
    window.addEventListener('load', function() {
        const form = document.getElementById('billForm');
        form.reset();
        
        // Set the bill number from server
        document.getElementById('billNumber').value = '<%= nextBillNumber %>';
        
        document.addEventListener('keydown', function(event) {
        // Check if Alt + H is pressed
        if (event.altKey && event.key.toLowerCase() === 'h') {
          event.preventDefault(); // Prevent default browser behavior
          window.location.href = '/';
        }
      });
        // Set default date to today in IST
        const today = new Date();
        today.setHours(today.getHours() + 5); // Add 5 hours
        today.setMinutes(today.getMinutes() + 30); // Add 30 minutes
        document.getElementById('date').value = today.toISOString().split('T')[0];
        
        // Clear item fields
        document.getElementById('itemFields').innerHTML = '';
        
        // Initialize gross weight fields visibility
        toggleGrossWeightFields();
    });

    // Add this event listener to the form to prevent default submission on Enter key
    document.getElementById('billForm').addEventListener('keypress', function(e) {
      // Check if the key pressed was Enter
      if (e.key === 'Enter') {
        // Prevent the default form submission
        e.preventDefault();
        
        showConfirmation(e);
      }
    });
  

    // Toggle gross weight fields based on gold/silver selection
    function toggleGrossWeightFields() {
      const selection = document.getElementById('goldSilver').value;
      const goldContainer = document.getElementById('grossGoldWeightContainer');
      const silverContainer = document.getElementById('grossSilverWeightContainer');
      const grossWeightContainer = document.getElementById('grossWeightContainer');
      
      // Reset values and show the container if needed
      document.getElementById('goldGrossWeight').value = '0.000';
      document.getElementById('silverGrossWeight').value = '0.000';
      
      if (selection === 'Gold' || selection === 'Silver' || selection === 'GoldSilver') {
        grossWeightContainer.style.display = 'block';
      } else {
        grossWeightContainer.style.display = 'none';
      }
      
      // Toggle visibility
      if (selection === 'Gold' || selection === 'GoldSilver') {
        goldContainer.style.display = 'block';
        document.getElementById('goldGrossWeight').required = true;
      } else {
        goldContainer.style.display = 'none';
        document.getElementById('goldGrossWeight').required = false;
      }
      
      if (selection === 'Silver' || selection === 'GoldSilver') {
        silverContainer.style.display = 'block';
        document.getElementById('silverGrossWeight').required = true;
      } else {
        silverContainer.style.display = 'none';
        document.getElementById('silverGrossWeight').required = false;
      }
      
      // Update gross weights if we have items already
      updateGrossWeights();
    }

    // Add event listener for the S series toggle switch
    document.getElementById('useSeries').addEventListener('change', function() {
      // Fetch the appropriate bill number when toggle state changes
      fetchNextBillNumber(this.checked);
    });

    function fetchNextBillNumber(useSeries) {
      fetch(`/get-next-bill-number?useSeries=${useSeries}`)
        .then(response => response.json())
        .then(data => {
          document.getElementById('billNumber').value = data.nextBillNumber;
        })
        .catch(error => {
          console.error('Error fetching bill number:', error);
        });
    }

    // Format the weight with 3 decimal places
    function formatWeight(input) {
      if (input.value) {
        // Parse the input value and format it to 3 decimal places
        const formattedValue = parseFloat(input.value).toFixed(3);
        // Update the input field with the formatted value
        input.value = formattedValue;
        
        // Update total weight and gross weights
        updateTotalWeight();
        updateGrossWeights();
      }
    }

    // Update gross weights based on item types
    function updateGrossWeights() {
      const noOfItems = parseInt(document.getElementById('noOfItems').value);
      const goldSilverSelection = document.getElementById('goldSilver').value;
      
      if (isNaN(noOfItems) || noOfItems < 1) {
        return;
      }
      
      let goldWeight = 0;
      let silverWeight = 0;
      
      for (let i = 1; i <= noOfItems; i++) {
        const typeToggle = document.getElementById(`itemType${i}`);
        const weightInput = document.getElementById(`itemWeight${i}`);
        
        if (weightInput && !isNaN(parseFloat(weightInput.value))) {
          const weight = parseFloat(weightInput.value);
          
          // If we're in Gold & Silver mode, check the toggle for each item
          if (goldSilverSelection === 'GoldSilver') {
            if (typeToggle && typeToggle.checked) {
              silverWeight += weight;
            } else {
              goldWeight += weight;
            }
          } 
          // If it's just Gold mode, all weights go to gold
          else if (goldSilverSelection === 'Gold') {
            goldWeight += weight;
          } 
          // If it's just Silver mode, all weights go to silver
          else if (goldSilverSelection === 'Silver') {
            silverWeight += weight;
          }
        }
      }
      
      // Update the gross weight fields with formatted values
      if (goldSilverSelection === 'Gold' || goldSilverSelection === 'GoldSilver') {
        document.getElementById('goldGrossWeight').value = goldWeight.toFixed(3);
      }
      
      if (goldSilverSelection === 'Silver' || goldSilverSelection === 'GoldSilver') {
        document.getElementById('silverGrossWeight').value = silverWeight.toFixed(3);
      }
    }

    // When generating item fields, add the gold/silver toggle and format the weight
    function generateItemFields() {
      const noOfItems = parseInt(document.getElementById('noOfItems').value);
      const itemFieldsDiv = document.getElementById('itemFields');
      const goldSilverSelection = document.getElementById('goldSilver').value;
      
      itemFieldsDiv.innerHTML = '';

      if (isNaN(noOfItems) || noOfItems < 1) {
        showErrorMessage('Please enter a valid number of items (minimum 1).');
        return;
      }

      for (let i = 1; i <= noOfItems; i++) {
        const itemRow = document.createElement('div');
        itemRow.className = 'item-row';
        
        // Basic item inputs
        let itemHTML = `
          <div class="item-label">Item ${i}:</div>
          <div class="item-inputs">
            <input type="text" id="itemName${i}" name="itemName${i}" placeholder="Item name" required>
        `;
        
        // Add gold/silver toggle for Gold & Silver mode
        if (goldSilverSelection === 'GoldSilver') {
          itemHTML += `
            <div class="metal-toggle-container">
              <span class="metal-toggle-label">Gold</span>
              <label class="toggle-switch small">
                <input type="checkbox" id="itemType${i}" name="itemType${i}" onchange="updateGrossWeights()">
                <span class="toggle-slider"></span>
              </label>
              <span class="metal-toggle-label">Silver</span>
            </div>
          `;
        }
        
        // Weight and value inputs
        itemHTML += `
            <input type="number" id="itemWeight${i}" name="itemWeight${i}" placeholder="Weight" step="0.001" min="0" required 
                   onblur="formatWeight(this)" onchange="updateTotalWeight()">
            <span>gms</span>
            <input type="number" id="itemValue${i}" name="itemValue${i}" placeholder="Value (₹)" min="0" required>
          </div>
        `;
        
        itemRow.innerHTML = itemHTML;
        itemFieldsDiv.appendChild(itemRow);
      }
      
      document.getElementById('totalWeightsContainer').style.display = 'block';
      
      // Initialize gross weights
      updateTotalWeight();
      updateGrossWeights();
    }

    function updateTotalWeight() {
      const noOfItems = parseInt(document.getElementById('noOfItems').value);
      let totalWeight = 0;
      
      for (let i = 1; i <= noOfItems; i++) {
        const weightInput = document.getElementById(`itemWeight${i}`);
        if (weightInput && !isNaN(parseFloat(weightInput.value))) {
          totalWeight += parseFloat(weightInput.value);
        }
      }
      
      // Display with 3 decimal places
      document.getElementById('totalWeight').textContent = totalWeight.toFixed(3);
      
      // Update gross weights
      updateGrossWeights();
    }
    
    function validatePhoneNumber(input) {
      // Ensure it's a valid 10-digit phone number
      if (input.value.length > 10) {
        input.value = input.value.slice(0, 10);
      }
      
      // Only allow digits
      input.value = input.value.replace(/[^0-9]/g, '');
      
      // Validate length
      if (input.value.length !== 10 && input.value.length > 0) {
        input.setCustomValidity('Phone number must be 10 digits');
      } else {
        input.setCustomValidity('');
      }
    }

    function validateAadharNumber(input) {
      // Ensure it's a valid 12-digit Aadhar number
      if (input.value.length > 12) {
        input.value = input.value.slice(0, 12);
      }
      
      // Only allow digits
      input.value = input.value.replace(/[^0-9]/g, '');
      
      // Validate length if provided
      if (input.value.length !== 0 && input.value.length !== 12) {
        input.setCustomValidity('Aadhar number must be 12 digits');
      } else {
        input.setCustomValidity('');
      }
    }

    function showConfirmation(event) {
      event.preventDefault();
      
      // Validate all required fields
      const form = document.getElementById('billForm');
      if (!form.checkValidity()) {
        // Trigger browser's built-in validation
        form.reportValidity();
        return;
      }
      
      // Build the items and values JSON
      const result = buildItemsJson();
      if (!result) {
        return; // Validation failed
      }
      
      // Set the hidden field values
      document.getElementById('items').value = JSON.stringify(result.itemsObj);
      document.getElementById('itemsValue').value = JSON.stringify(result.itemsValueObj);

      // Set confirmation modal details
      document.getElementById('confirmBillType').textContent = 
        form.useSeries.checked ? 'S Series' : 'Standard';
      document.getElementById('confirmBillNumber').textContent = form.billNumber.value;
      document.getElementById('confirmName').textContent = form.name.value;
      document.getElementById('confirmPhone').textContent = form.phoneNumber.value;
      document.getElementById('confirmAmount').textContent = form.initialPledgedAmount.value;
      
      // Add gross weight info to confirmation
      const grossWeightsDiv = document.getElementById('confirmGrossWeights');
      grossWeightsDiv.innerHTML = '';
      
      const goldSilver = form.goldSilver.value;
      if (goldSilver === 'Gold' || goldSilver === 'GoldSilver') {
        const p = document.createElement('p');
        p.innerHTML = `<strong>Gross Gold Weight:</strong> ${form.goldGrossWeight.value} gms`;
        grossWeightsDiv.appendChild(p);
      }
      
      if (goldSilver === 'Silver' || goldSilver === 'GoldSilver') {
        const p = document.createElement('p');
        p.innerHTML = `<strong>Gross Silver Weight:</strong> ${form.silverGrossWeight.value} gms`;
        grossWeightsDiv.appendChild(p);
      }
      
      // Format the items for display
      const itemsForDisplay = result.itemsForDisplay.join(', ');
      document.getElementById('confirmItems').textContent = itemsForDisplay;
      
      document.getElementById('confirmRemarks').textContent = form.remarks.value || 'None';

      document.getElementById('confirmationModal').style.display = 'block';
    }

    function buildItemsJson() {
      const noOfItems = parseInt(document.getElementById('noOfItems').value);
      const goldSilverSelection = document.getElementById('goldSilver').value;
      const itemsObj = {};
      const itemsValueObj = {};
      const itemsForDisplay = [];
      
      // Validate all fields are filled
      for (let i = 1; i <= noOfItems; i++) {
        const nameInput = document.getElementById(`itemName${i}`);
        const weightInput = document.getElementById(`itemWeight${i}`);
        const valueInput = document.getElementById(`itemValue${i}`);
        
        if (!nameInput || !nameInput.value || !weightInput || !weightInput.value || !valueInput || !valueInput.value) {
          showErrorMessage('Please fill in all item details');
          return null;
        }
        
        // Format weight with 3 decimal places
        const weight = parseFloat(weightInput.value).toFixed(3);
        
        // Add to the JSON objects
        itemsObj[nameInput.value] = `${weight}gms`;
        itemsValueObj[nameInput.value] = valueInput.value;
        
        // Metal type for display
        let metalType = goldSilverSelection;
        if (goldSilverSelection === 'GoldSilver') {
          const typeToggle = document.getElementById(`itemType${i}`);
          metalType = typeToggle && typeToggle.checked ? 'Silver' : 'Gold';
        }
        
        itemsForDisplay.push(`${nameInput.value}: ${weight}gms (${metalType})`);
      }
      
      return { itemsObj, itemsValueObj, itemsForDisplay };
    }

    function closeModal() {
      document.getElementById('confirmationModal').style.display = 'none';
    }

    function confirmAndSubmit() {
      const form = document.getElementById('billForm');
      closeModal();
      // Get the bill number from the form
      const billNumber = form.billNumber.value;
      
      // Show the toaster with the bill number
      showToaster(`Processing bill Number ${billNumber} Please hold on! ⏳`, 'success');      
      // Delay form submission slightly to allow toaster to be visible
      setTimeout(() => {
        form.submit();  // This submits to /add-bill as defined in form's action attribute
      }, 1500);
    }
    
    function showToaster(message, type = 'success') {
      let toaster = document.getElementById('toaster');
      if (!toaster) {
          toaster = document.createElement('div');
          toaster.id = 'toaster';
          document.body.appendChild(toaster);
      }

      toaster.innerHTML = `
          <div class="toaster-content">
              <div class="tick-mark ${type}">
                  <svg viewBox="0 0 52 52">
                      <circle class="circle" cx="26" cy="26" r="25"/>
                      <path class="check" d="M14 27l8 8 16-16"/>
                  </svg>
              </div>
              <span class="message">${message}</span>
          </div>
      `;

      toaster.style.display = 'flex';
      setTimeout(() => {
          toaster.classList.add('show');
      }, 10);

      setTimeout(() => {
          toaster.classList.remove('show');
          setTimeout(() => {
              toaster.style.display = 'none';
          }, 300);
      }, 3000);
    }
    
    function showErrorMessage(message) {
      showToaster(message, 'error');
    }
  </script>
  
  <style>
    .success-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .success-content {
        background: white;
        padding: 30px;
        border-radius: 10px;
        text-align: center;
        animation: dropIn 0.5s ease-out;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        max-width: 400px;
        width: 90%;
    }

    .success-buttons {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-top: 25px;
        flex-wrap: wrap;
    }

    .success-button {
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .print-btn {
        background: #4CAF50;
        color: white;
    }

    .new-bill-btn {
        background: #2196F3;
        color: white;
    }

    .home-btn {
        background: #607D8B;
        color: white;
    }

    .success-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .checkmark-circle {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
    }

    .success-message {
        color: #333;
        font-size: 1.2em;
        margin: 15px 0;
    }

    @keyframes dropIn {
        0% {
            transform: translateY(-100px);
            opacity: 0;
        }
        60% {
            transform: translateY(20px);
        }
        100% {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .checkmark {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: block;
        stroke-width: 2;
        stroke: #4CAF50;
        stroke-miterlimit: 10;
        box-shadow: inset 0 0 0 #4CAF50;
        animation: fill .4s ease-in-out .4s forwards, scale .3s ease-in-out .9s both;
    }

    @keyframes fill {
        100% {
            box-shadow: inset 0 0 0 50px #4CAF50;
        }
    }

    @keyframes scale {
        0%, 100% {
            transform: none;
        }
        50% {
            transform: scale3d(1.1, 1.1, 1);
        }
    }
    .modal {
      display: none;
      position: fixed;
      z-index: 1;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: auto;
      background-color: rgba(0,0,0,0.4);
      justify-content: center;
      align-items: center;
    }
    
    .modal-content {
      background-color: #fefefe;
      padding: 20px;
      border: 1px solid #888;
      width: 60%;
      border-radius: 5px;
      max-height: 80vh;
      overflow-y: auto;
      /* Remove: position, top, transform, margin properties */
    }
    
    .modal-buttons {
      display: flex;
      justify-content: space-around;
      margin-top: 20px;
    }
    
    .modal-buttons button {
      padding: 10px 20px;
      background-color: #4CAF50;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }
    
    .modal-buttons button:last-child {
      background-color: #f44336;
    }
    /* Toggle Switch Styles */
    .toggle-switch {
      position: relative;
      display: inline-block;
      width: 50px;
      height: 24px;
      margin-right: 10px;
    }
    
    .toggle-switch.small {
      width: 40px;
      height: 20px;
    }
    
    .toggle-switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }
    
    .toggle-slider {
      position: absolute;
      cursor: pointer;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: #cccccc;
      transition: .3s;
      border-radius: 24px;
    }
    
    /* Main S Series toggle remains blue */
    input:checked + .toggle-slider {
      background-color: #2196F3;
    }
    
    /* Gold/Silver toggle specific styles */
    .metal-toggle-container .toggle-switch .toggle-slider {
      background-color: #FFD700; /* Gold color when unchecked */
    }
    
    .metal-toggle-container .toggle-switch input:checked + .toggle-slider {
      background-color: #C0C0C0; /* Silver color when checked */
    }
    
    /* Rest of the toggle styles */
    .toggle-slider:before {
      position: absolute;
      content: "";
      height: 18px;
      width: 18px;
      left: 3px;
      bottom: 3px;
      background-color: white;
      transition: .3s;
      border-radius: 50%;
    }
    
    .toggle-switch.small .toggle-slider:before {
      height: 14px;
      width: 14px;
      left: 3px;
      bottom: 3px;
    }
    
    input:checked + .toggle-slider:before {
      transform: translateX(26px);
    }
    
    .toggle-switch.small input:checked + .toggle-slider:before {
      transform: translateX(20px);
    }
    
    .toggle-label {
      font-weight: 500;
    }
    
    .toggle-container {
      display: flex;
      align-items: center;
      margin-bottom: 15px;
    }
    
    /* Metal toggle styles */
    .metal-toggle-container {
      display: flex;
      align-items: center;
      margin: 0 10px;
      background-color: #fdfcfc;
      padding: 2px 8px;
      border-radius: 16px;
      border: 1px solid #dee2e6;
    }
    
    .metal-toggle-label {
      font-size: 0.8rem;
      font-weight: 500;
      margin: 0 5px;
    }
    
    /* Gross weight container styles */
    #grossWeightContainer {
      background-color: #f9f9f9;
      padding: 12px;
      border-radius: 6px;
      border: 1px solid #ddd;
      margin-bottom: 15px;
    }
    
    #grossWeightContainer > div {
      margin-bottom: 10px;
    }
    
    #grossWeightContainer > div:last-child {
      margin-bottom: 0;
    }
    
    #toaster {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .toaster-content {
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        opacity: 0;
        transform: scale(0.8);
        transition: all 0.3s ease;
    }

    #toaster.show .toaster-content {
        opacity: 1;
        transform: scale(1);
    }

    .tick-mark {
        width: 60px;
        height: 60px;
        position: relative;
    }

    .tick-mark.success .circle {
        stroke: #00cc00;
        fill: none;
    }

    .tick-mark.error .circle {
        stroke: #ff0000;
        fill: none;
    }

    .circle {
        stroke-width: 2;
        stroke-linecap: round;
        stroke-dasharray: 157; /* 2πr ≈ 157 for r=25 */
        stroke-dashoffset: 157;
        animation: strokeCircle 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
    }

    .check {
        fill: none;
        stroke: #ffffff;
        stroke-width: 3; /* Increased for better visibility */
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 48; /* Length of checkmark path */
        stroke-dashoffset: 48;
        animation: strokeCheck 0.4s cubic-bezier(0.65, 0, 0.45, 1) 0.6s forwards;
    }

    @keyframes strokeCircle {
        to {
            stroke-dashoffset: 0;
        }
    }

    @keyframes strokeCheck {
        to {
            stroke-dashoffset: 0;
        }
    }

    .message {
        color: #333;
        font-family: Arial, sans-serif;
        font-size: 16px;
    }
    
    /* Styles for item grid */
    .item-grid {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 15px;
    }
    
    .item-row {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .item-label {
        width: 80px;
        font-weight: bold;
    }
    .item-inputs {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 10px;
}

.item-inputs input[type="text"] {
    flex: 2;
}

.item-inputs input[type="number"] {
    flex: 1;
}

.item-inputs span {
    flex: 0 0 auto;
}

/* Making the form responsive */
@media (max-width: 768px) {
    .item-row {
        flex-direction: column;
        align-items: flex-start;
    }
    
    .item-label {
        width: 100%;
        margin-bottom: 5px;
    }
    
    .item-inputs {
        width: 100%;
        flex-wrap: wrap;
    }
    
    .modal-content {
        width: 90%;
    }
}

/* Total weight container styling */
#totalWeightsContainer {
    background-color: #f0f8ff;
    padding: 10px;
    border-radius: 4px;
    border: 1px solid #b8daff;
    margin-bottom: 15px;
}

/* Modal display fix */
.modal {
    display: none;
}

.modal[style*="display: block"] {
    display: flex !important;
}
    
  </style>
</body>
</html>
