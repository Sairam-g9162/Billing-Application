<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Database Backup Manager</title>
    <link rel="stylesheet" href="/styles.css">
    <style>
        :root {
            --primary-color: #4361ee;
            --primary-hover: #3a56d4;
            --secondary-color: #3f37c9;
            --success-color: #4cc9f0;
            --light-bg: #f8f9fa;
            --dark-text: #212529;
            --light-text: #f8f9fa;
            --border-radius: 8px;
            --box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #e9ecef;
            color: var(--dark-text);
            min-height: 100vh;
        }

        .main-container {
            display: flex;
            min-height: 100vh;
        }


        .content {
            flex-grow: 1;
            padding: 30px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            background-color: white;
            border-radius: var(--border-radius);
            padding: 30px;
            box-shadow: var(--box-shadow);
            max-width: 800px;
            width: 100%;
        }

        h1 {
            color: var(--dark-text);
            text-align: center;
            margin-bottom: 30px;
            font-weight: 600;
            position: relative;
            padding-bottom: 15px;
        }

        h1:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 4px;
            background-color: var(--primary-color);
            border-radius: 2px;
        }

        .button-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 30px;
        }

        .date-input {
            display: none;
            margin-top: 25px;
            background-color: var(--light-bg);
            padding: 20px;
            border-radius: var(--border-radius);
            animation: fadeIn 0.3s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .date-input label {
            display: block;
            margin-bottom: 10px;
            font-weight: 500;
        }

        #customDate {
            padding: 10px;
            border-radius: var(--border-radius);
            border: 1px solid #ced4da;
            width: 100%;
            font-size: 16px;
            margin-bottom: 15px;
        }

        #submitCustomDate {
            width: 100%;
            margin-top: 10px;
            background-color: var(--success-color);
        }

        #submitCustomDate:hover {
            background-color: #3db8db;
        }

        .loading {
            display: none;
            text-align: center;
            margin-top: 30px;
        }

        .spinner {
            border: 4px solid rgba(0, 0, 0, 0.1);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border-left-color: var(--primary-color);
            animation: spin 1s linear infinite;
            margin: 0 auto 15px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .message {
            text-align: center;
            margin-top: 30px;
            padding: 15px;
            border-radius: var(--border-radius);
            display: none;
            animation: fadeIn 0.3s ease-in-out;
        }

        .success-message {
            background-color: #d1e7dd;
            color: #0f5132;
        }

        .error-message {
            background-color: #f8d7da;
            color: #842029;
        }

        /* Responsive adjustments */
        @media (max-width: 768px) {
            .main-container {
                flex-direction: column;
            }
            
           
            
            
            .content {
                padding: 20px 15px;
            }
            
            .button-container {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="main-container">

        <div class="content">
            <div class="container">
                <a href="/" class="back-button">Home</a>

                <h1>Database Backup Manager</h1>
                
                <div class="button-container">
                    <button id="completeBackup"><i class="fas fa-save"></i> Complete Data Backup</button>
                    <button id="todaysBackup"><i class="fas fa-calendar-day"></i> Today's Data Backup</button>
                    <button id="customBackup"><i class="fas fa-calendar-alt"></i> Custom Date Backup</button>
                </div>
                
                <div id="dateInput" class="date-input">
                    <label for="customDate"><i class="fas fa-calendar"></i> Select Date:</label>
                    <input type="date" id="customDate" required>
                    <button id="submitCustomDate"><i class="fas fa-check"></i> Create Backup</button>
                </div>
                
                <div class="loading" id="loading">
                    <div class="spinner"></div>
                    <p>Creating backup, please wait...</p>
                </div>
                
                <div class="message success-message" id="successMessage">
                    <i class="fas fa-check-circle" style="font-size: 24px; margin-bottom: 10px;"></i>
                    <p>Backup completed successfully!</p>
                </div>
                
                <div class="message error-message" id="errorMessage">
                    <i class="fas fa-exclamation-circle" style="font-size: 24px; margin-bottom: 10px;"></i>
                    <p>An error occurred during backup. Please try again.</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const completeBackup = document.getElementById('completeBackup');
            const todaysBackup = document.getElementById('todaysBackup');
            const customBackup = document.getElementById('customBackup');
            const dateInput = document.getElementById('dateInput');
            const customDate = document.getElementById('customDate');
            const submitCustomDate = document.getElementById('submitCustomDate');
            const loading = document.getElementById('loading');
            const successMessage = document.getElementById('successMessage');
            const errorMessage = document.getElementById('errorMessage');
            
            // Set today's date as default
            const today = new Date().toISOString().split('T')[0];
            customDate.value = today;
            
            // Event listeners
            completeBackup.addEventListener('click', function() {
                performBackup('complete');
            });
            
            todaysBackup.addEventListener('click', function() {
                performBackup('today');
            });
            
            customBackup.addEventListener('click', function() {
                dateInput.style.display = 'block';
            });
            
            submitCustomDate.addEventListener('click', function() {
                if (customDate.value) {
                    performBackup('custom', customDate.value);
                }
            });
            
            function performBackup(type, date = null) {
                // Hide date input if visible
                dateInput.style.display = 'none';
                
                // Show loading, hide messages
                loading.style.display = 'block';
                successMessage.style.display = 'none';
                errorMessage.style.display = 'none';
                
                let url = '/backup?type=' + type;
                if (type === 'custom' && date) {
                    url += '&date=' + date;
                }
                
                // Simulate network delay for demo purposes
                setTimeout(() => {
                    fetch(url)
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('Backup failed');
                            }
                            return response.text();
                        })
                        .then(data => {
                            loading.style.display = 'none';
                            successMessage.style.display = 'block';
                            setTimeout(() => {
                                successMessage.style.display = 'none';
                            }, 5000);
                        })
                        .catch(error => {
                            loading.style.display = 'none';
                            errorMessage.style.display = 'block';
                            setTimeout(() => {
                                errorMessage.style.display = 'none';
                            }, 5000);
                            console.error('Error:', error);
                        });
                }, 1000);
            }
        });
    </script>
</body>
</html>