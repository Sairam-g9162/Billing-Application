    // Function to submit new expense
    function submitExpense(expenseDate, expenseDetails, totalAmount, useSecondaryTable) {
        fetch('/add-expense', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                expenseDate,
                expenseDetails,
                totalAmount,
                useSecondaryTable
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Close preview modal
                document.getElementById('previewModal').style.display = 'none';
                
                // Show success message
                const successModal = document.getElementById('successModal');
                document.getElementById('successMessage').textContent = data.message;
                successModal.style.display = 'flex';
                
                // Reset form
                document.getElementById('expenseDate').value = new Date().toISOString().split('T')[0];
                document.getElementById('expenseItems').innerHTML = '';
                addExpenseItemRow('expenseItems');
                
                // Hide success modal after 2 seconds
                setTimeout(() => {
                    successModal.style.display = 'none';
                }, 2000);
            } else {
                alert('Error: ' + data.error);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Failed to submit expense');
        });
    }
    
    // Function to update existing expense
    function updateExpense(expenseId, expenseDate, expenseDetails, totalAmount, useSecondaryTable) {
        fetch(`/update-expense/${expenseId}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                expenseDate,
                expenseDetails,
                totalAmount,
                useSecondaryTable
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Close preview modal
                document.getElementById('previewModal').style.display = 'none';
                
                // Show success message
                const successModal = document.getElementById('successModal');
                document.getElementById('successMessage').textContent = data.message;
                successModal.style.display = 'flex';
                
                // Reset edit form and show expenses list
                document.getElementById('editExpenseFormContainer').classList.add('hidden');
                
                // Refresh expense list
                const month = document.getElementById('editExpenseMonth').value;
                const year = document.getElementById('editExpenseYear').value;
                fetchExpenses(month, year, useSecondaryTable, 'edit');
                
                // Hide success modal after 2 seconds
                setTimeout(() => {
                    successModal.style.display = 'none';
                }, 2000);
            } else {
                alert('Error: ' + data.error);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Failed to update expense');
        });
    }
    
    // Initialize with first expense item
    if (document.querySelectorAll('#expenseItems .expense-item').length === 0) {
        addExpenseItemRow('expenseItems');
    }
});
